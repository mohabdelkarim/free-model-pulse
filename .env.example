# OpenRouter API Key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_api_key_here

# Optional: Site URL for OpenRouter requests
OPENROUTER_SITE_URL=https://github.com/yourusername/free-model-pulse

# Optional: Site Email for OpenRouter requests
OPENROUTER_SITE_EMAIL=your_email@example.com

# Benchmark settings
BENCHMARK_PROMPT_FILE=prompts.json
BENCHMARK_TIMEOUT_SEC=120
BENCHMARK_MAX_RETRIES=3
BENCHMARK_RETRY_DELAY_SEC=5

# Data directories (defaults)
DATA_DIR=data
CATALOGS_DIR=data/catalogs
RUNS_DIR=data/runs
DERIVED_DIR=data/derived

# Model discovery settings
WATCH_INTERVAL_MINUTES=60
FORCE_REDISCOVER=false

# Analysis settings
ANALYSIS_WINDOW_DAYS=30
MIN_RUNS_FOR_AGGREGATION=3
